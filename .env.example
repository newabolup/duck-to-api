DUCK_API_HOST=127.0.0.1
DUCK_API_PORT=8000
# Optional Bearer API key for /v1/*, /api/v1/*, and /files/* routes (strongly recommended when DUCK_API_HOST=0.0.0.0)
DUCK_API_API_KEY=
DUCK_API_DEFAULT_ADAPTER=duck-ai
DUCK_API_DATA_DIR=data
# Duck.ai rejects Playwright headless UA; keep false (start.sh uses xvfb-run automatically on headless Linux servers).
DUCK_API_BROWSER_HEADLESS=false
DUCK_API_CHROMIUM_NO_SANDBOX=false
DUCK_API_MAX_CONCURRENT_JOBS=1
DUCK_API_JOB_TIMEOUT_SECONDS=180
DUCK_API_SYNC_WAIT_TIMEOUT_SECONDS=300
DUCK_API_MAX_UPLOAD_BYTES=20971520
DUCK_API_ENABLE_BROWSER_ON_STARTUP=true
# Optional public base URL used when returning image URLs behind a reverse proxy or LAN hostname
DUCK_API_BASE_URL=
